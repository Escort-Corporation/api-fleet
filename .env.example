SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-secret-key
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# Motorista autônomo — PREPARADO e DESLIGADO no MVP (MOTORISTA_AUTONOMO.md na raiz).
# Ligar exige as três confirmações abaixo; sem elas o serviço não sobe.
AUTONOMOUS_DRIVERS_ENABLED=false
# advogado de transporte (Lei 11.442/2007, piso ANTT, risco trabalhista)
AUTONOMOUS_LEGAL_REVIEW_DONE=false
# seguro de carga e responsabilidade civil
AUTONOMOUS_CARGO_INSURANCE_ACTIVE=false
# RNTRC/CIOT do frete avulso
AUTONOMOUS_RNTRC_CIOT_READY=false
# volume mínimo de fretes/semana para haver escolha real
AUTONOMOUS_MIN_WEEKLY_OFFERS=50
